    "## 11. Benchmark: Python loops versus vectorised NumPy\n",
    "\n",
    "This benchmark compares column means implemented with a nested Python loop against NumCompute’s vectorised `mean`. The input is generated with a fixed random seed. Timings vary by hardware, Python/NumPy versions, and system load, so use the measured values from your own run when writing the report."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "9c519075",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-22T06:10:05.701811Z",
     "iopub.status.busy": "2026-10-22T06:10:05.701548Z",
     "iopub.status.idle": "2026-10-22T06:10:05.806439Z",
     "shell.execute_reply": "2026-10-22T06:10:05.804843Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Implementation              Median per call (ms)\n",
      "-------------------------------------------------\n",
      "Vectorised NumPy                          0.1144\n",
      "Nested Python loops                       5.4714\n",
      "\n",
      "Measured loop/vectorised speed ratio: 47.83x\n",
      "Environment notes:\n",
      "  Python: 3.12.10\n",
      "  NumPy: 2.5.4\n",
      "  Platform: Windows-11-10.0.26200-SP0\n",
      "  Input shape: (3000, 20)\n",
      "  Timing configuration: repeat=3, number=2, warmup=1\n"
     ]
    }
   ],
   "source": [
    "rng = np.random.default_rng(2026)\n",
    "benchmark_matrix = rng.normal(size=(3000, 20))\n",
    "\n",
    "def vectorised_column_mean():\n",
    "    return mean(benchmark_matrix, axis=0)\n",
    "\n",
    "def python_loop_column_mean():\n",
    "    n_rows, n_columns = benchmark_matrix.shape\n",
    "    result = np.empty(n_columns, dtype=float)\n",
    "    for column in range(n_columns):\n",
    "        total = 0.0\n",
    "        for row in range(n_rows):\n",
    "            total += benchmark_matrix[row, column]\n",
    "        result[column] = total / n_rows\n",
    "    return result\n",
    "\n",
    "# Check equality before interpreting any timing difference.\n",
    "np.testing.assert_allclose(\n",
    "    vectorised_column_mean(), python_loop_column_mean(),\n",
    "    rtol=1e-12, atol=1e-12,\n",
    ")\n",
    "\n",
    "benchmark_result = compare_implementations(\n",
    "    vectorised_column_mean,\n",
    "    python_loop_column_mean,\n",
    "    repeat=3,\n",
    "    number=2,\n",
    "    warmup=1,\n",
    ")\n",
    "vectorised_ms = benchmark_result[\"vectorized\"][\"median_seconds\"] * 1000.0\n",
    "loop_ms = benchmark_result[\"loop\"][\"median_seconds\"] * 1000.0\n",
    "speedup = benchmark_result[\"speedup\"]\n",
    "\n",
    "print(f\"{'Implementation':<25} {'Median per call (ms)':>22}\")\n",
    "print(\"-\" * 49)\n",
    "print(f\"{'Vectorised NumPy':<25} {vectorised_ms:>22.4f}\")\n",
    "print(f\"{'Nested Python loops':<25} {loop_ms:>22.4f}\")\n",
    "print(f\"\\nMeasured loop/vectorised speed ratio: {speedup:.2f}x\")\n",
