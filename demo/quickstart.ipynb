    "# Numeric preprocessing pipeline: mean imputation followed by z-score scaling.\n",
    "numeric_pipeline = Pipeline([\n",
    "    (\"imputer\", SimpleImputer(strategy=\"mean\")),\n",
    "    (\"standard_scaler\", StandardScaler()),\n",
    "])\n",
    "X_numeric_scaled = numeric_pipeline.fit_transform(numeric_with_missing)\n",
    "\n",
    "print(\"Imputed values learned for each numeric feature:\")\n",
    "print(dict(zip(NUMERIC_NAMES, numeric_pipeline.named_steps[\"imputer\"].statistics_.round(3))))\n",
    "print(\"\\nScaled numeric matrix shape:\", X_numeric_scaled.shape)\n",
    "print(\"NaNs left after imputation:\", int(np.isnan(X_numeric_scaled).sum()))\n",
    "print(\"Scaled column means (approximately zero):\")\n",
    "print(np.round(mean(X_numeric_scaled, axis=0), 6))\n",
    "\n",
    "# Transform categorical columns separately because they are not numeric features.\n",
    "categorical_raw = raw[:, [column_names.index(\"program\"), column_names.index(\"study_mode\")]]\n",
    "categorical_clean = np.where(categorical_raw == \"\", \"Unknown\", categorical_raw)\n",
    "encoder = OneHotEncoder(handle_unknown=\"ignore\")\n",
    "X_categorical_encoded = encoder.fit_transform(categorical_clean)\n",
    "categorical_feature_names = encoder.get_feature_names_out([\"program\", \"study_mode\"])\n",
    "\n",
    "print(\"\\nOne-hot encoded matrix shape:\", X_categorical_encoded.shape)\n",
    "print(\"One-hot feature names:\", categorical_feature_names.tolist())\n",
