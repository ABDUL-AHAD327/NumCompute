    "## 9. Finite-difference gradient and Jacobian\n",
    "\n",
    "The gradient example uses a scalar-valued function of two inputs. The Jacobian example returns two outputs, so its Jacobian has shape `(number of outputs, number of input coordinates)`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "fb64b533",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-22T06:10:05.677040Z",
     "iopub.status.busy": "2026-10-22T06:10:05.676748Z",
     "iopub.status.idle": "2026-10-22T06:10:05.683419Z",
     "shell.execute_reply": "2026-10-22T06:10:05.682239Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Point: [ 2. -1.]\n",
      "Estimated gradient: [ 2. -2.]\n",
      "Analytical gradient for comparison: [2, -2]\n",
      "\n",
      "Jacobian point: [2. 3.]\n",
      "Estimated Jacobian (rows are output coordinates):\n",
      "[[3. 2.]\n",
      " [4. 1.]]\n",
      "Analytical Jacobian for comparison: [[3, 2], [4, 1]]\n"
     ]
    }
   ],
   "source": [
    "def scalar_function(x):\n",
    "    return x[0] ** 2 + 3.0 * x[1] ** 2 + 2.0 * x[0] * x[1]\n",
    "\n",
    "x_point = np.array([2.0, -1.0])\n",
    "gradient_estimate = grad(scalar_function, x_point, h=1e-5, method=\"central\")\n",
    "print(\"Point:\", x_point)\n",
    "print(\"Estimated gradient:\", np.round(gradient_estimate, 6))\n",
    "print(\"Analytical gradient for comparison: [2, -2]\")\n",
    "\n",
    "\n",
    "def vector_function(x):\n",
    "    return np.array([x[0] * x[1], x[0] ** 2 + x[1]])\n",
    "\n",
    "jacobian_point = np.array([2.0, 3.0])\n",
    "jacobian_estimate = jacobian(vector_function, jacobian_point, h=1e-5, method=\"central\")\n",
    "print(\"\\nJacobian point:\", jacobian_point)\n",
    "print(\"Estimated Jacobian (rows are output coordinates):\")\n",
    "print(np.round(jacobian_estimate, 6))\n",
    "print(\"Analytical Jacobian for comparison: [[3, 2], [4, 1]]\")"
   ]
  },
