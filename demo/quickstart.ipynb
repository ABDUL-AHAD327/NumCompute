   "source": [
    "student_ids = raw[:, column_names.index(\"student_id\")]\n",
    "final_scores = numeric_with_missing[:, NUMERIC_NAMES.index(\"final_score\")]\n",
    "\n",
    "# Stable full sorting.\n",
    "sorted_scores = stable_sort(final_scores)\n",
    "print(\"Lowest five final scores:\", sorted_scores[:5])\n",
    "print(\"Highest five final scores:\", sorted_scores[-5:][::-1])\n",
    "\n",
    "# Select the five highest scores without fully sorting the entire input.\n",
    "top_scores, top_indices = topk(final_scores, k=5, largest=True, return_indices=True)\n",
    "print(\"\\nTop five students [student_id, final_score, passed]:\")\n",
    "print(np.column_stack((student_ids[top_indices], top_scores.astype(str), raw[top_indices, column_names.index(\"passed\")])) )\n",
    "\n",
    "# Multi-key sort: descending final score, then descending attendance.\n",
    "attendance = numeric_with_missing[:, NUMERIC_NAMES.index(\"attendance_pct\")]\n",
    "sort_matrix = np.column_stack((final_scores, np.nan_to_num(attendance, nan=-np.inf)))\n",
    "order = multi_key_sort(sort_matrix, keys=[0, 1], ascending=[False, False], return_indices=True)\n",
    "print(\"\\nTop five row indices after multi-key sorting:\", order[:5])\n",
    "\n",
    "# Quickselect uses a zero-based k (k=0 is the smallest element).\n",
    "k_middle = len(final_scores) // 2\n",
    "selected_middle = quickselect(final_scores, k_middle)\n",
    "expected_middle = np.sort(final_scores)[k_middle]\n",
    "print(f\"\\nQuickselect at k={k_middle}: {selected_middle:.2f}\")\n",
    "print(f\"Same element from a full sort: {expected_middle:.2f}\")\n",
    "assert np.isclose(selected_middle, expected_middle)\n",
    "\n",
    "# Binary search returns (left insertion position, exact-match flag).\n",
    "search_target = 70.0\n",
    "insertion_index, exists = binary_search(sorted_scores, search_target)\n",
    "print(f\"\\nBinary search for {search_target:.1f}: insertion index={insertion_index}, exists={exists}\")"
   ]
